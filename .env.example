# Полный URL API организаторов с подписью (без group_id). Спросить у команды, не коммитить.
CQA_API_URL=
PORT=3000
# STORAGE_DIR=storage

# ---- LLM (OpenAI Chat Completions, structured outputs) ----
LLM_API_KEY=
# Точный id модели из кабинета OpenAI
LLM_MODEL=gpt-6-luna
# Необязательно: другой OpenAI-совместимый endpoint
# LLM_BASE_URL=
# Сколько прогонов на диалог для голосования (1 = дешевле, 3 = точнее)
LLM_RUNS=3
# Для reasoning-моделей: low | medium | high (не задавать, если модель не поддерживает)
# LLM_REASONING_EFFORT=medium
# Для обычных моделей: 0 (reasoning-модели могут не принимать temperature — тогда не задавать)
# LLM_TEMPERATURE=0
# Цены модели, USD за 1M токенов — для подсчёта стоимости оценки
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_CACHED_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=
