# Полный URL API организаторов с подписью, БЕЗ &group_id=... (кнопка «Открыть GET для DEV» в задании). Не коммитить.
CQA_API_URL=
PORT=3000
# STORAGE_DIR=storage

# ---- LLM (OpenAI Chat Completions, structured outputs) ----
LLM_API_KEY=
# gpt-6-luna — по умолчанию (дёшево); gpt-6.1-sol — точнее (92.5% против 88.8% на эталоне), рекомендуем для демо
LLM_MODEL=gpt-6-luna
# Необязательно: другой OpenAI-совместимый endpoint
# LLM_BASE_URL=
# Сколько прогонов на диалог для голосования (1 = дешевле, 3 = точнее)
LLM_RUNS=3
# Для reasoning-моделей: low | medium | high (не задавать, если модель не поддерживает)
LLM_REASONING_EFFORT=low
# Для обычных моделей: 0 (reasoning-модели могут не принимать temperature — тогда не задавать)
# LLM_TEMPERATURE=0
# Цены модели, USD за 1M токенов — для подсчёта стоимости оценки
# gpt-6.1-sol: 2 / 0.1 / 10;  gpt-6-luna: 0.1 / 0.01 / 0.5  (developers.openai.com/api/docs/pricing, 07.11.2026)
LLM_PRICE_INPUT_PER_1M=0.1
LLM_PRICE_CACHED_INPUT_PER_1M=0.01
LLM_PRICE_OUTPUT_PER_1M=0.5

# ---- Точность: перепроверка спорных критериев и прецеденты из апелляций ----
# Если прогоны LLM_MODEL разошлись по критерию (confidence < 1) или ответа нет (manual) — этот критерий
# перепроверяет более сильная модель. Пусто — перепроверки нет.
LLM_ESCALATE_MODEL=gpt-6.1-sol
# LLM_ESCALATE_REASONING_EFFORT=low
LLM_ESCALATE_PRICE_INPUT_PER_1M=2
LLM_ESCALATE_PRICE_CACHED_INPUT_PER_1M=0.1
LLM_ESCALATE_PRICE_OUTPUT_PER_1M=10
# Сколько решений проверяющих по апелляциям показывать модели у каждого критерия как прецеденты (0 — выключить)
LLM_APPEAL_EXAMPLES=3
